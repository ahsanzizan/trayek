{
  "name": "trayek",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "baseline:report": "tsx --env-file=.env src/server/baseline/report.ts",
    "build": "next build",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:invariants",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "start": "next start",
    "worker": "tsx --env-file=.env src/server/jobs/worker.ts",
    "test:e2e": "if find tests/e2e -type f -name '*.spec.ts' -print -quit 2>/dev/null | grep -q .; then PLAYWRIGHT_WITH_SERVER=1 playwright test --pass-with-no-tests; else playwright test --pass-with-no-tests; fi",
    "test:invariants": "vitest run tests/invariants",
    "test:unit": "vitest run --passWithNoTests --exclude \"tests/invariants/**\"",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.2",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.6.0",
    "@sentry/nextjs": "^10.71.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@uploadthing/react": "^7.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "^15.2.3",
    "next-auth": "5.0.0-beta.25",
    "papaparse": "^5.7.0",
    "pg-boss": "^12.28.0",
    "pino": "^10.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.85.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "superjson": "^2.2.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uploadthing": "^7.7.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^20.14.10",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.6.0",
    "tailwindcss": "^4.0.15",
    "tsx": "^4.23.12",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "vitest": "^4.1.11"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "pnpm@10.33.0"
}
