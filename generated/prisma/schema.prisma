// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  FORWARDER
  SHIPPER
}

enum MembershipRole {
  OWNER
  ADMIN
  FINANCE
  VIEWER
}

/// The life of one order, from despatch to cash. Each transition is a step the
/// product either automates or gates; nothing here is a pricing state.
enum OrderStatus {
  CREATED
  IN_TRANSIT
  DELIVERED
  POD_RECEIVED
  POD_VALIDATED
  PACKET_READY
  INVOICED
  PAID
  REJECTED
}

/// How a baseline DSO figure was arrived at. Kept separate because they mean
/// different things: what an owner believes is a sales signal, what the data
/// says is the number we are held to.
enum DsoBaselineMethod {
  CLAIMED
  COMPUTED_FROM_INVOICES
  COMPUTED_FROM_BALANCES
}

/// Whether the driver's browser gave up a location at capture time (TRK-032).
///
/// `DENIED` is a weak signal and nothing more. Drivers refuse prompts they do
/// not understand, on phones they share, in warehouses with no sky view — so a
/// refusal must never read as evidence of anything (INV-4).
enum GeolocationPermission {
  GRANTED
  DENIED
  UNAVAILABLE
}

enum AuditActorType {
  USER
  AGENT
  SYSTEM
}

enum ChannelType {
  WHATSAPP_BAILEYS
  EMAIL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageLogStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum ChannelConnectionStatus {
  CONNECTED
  DISCONNECTED
  NEEDS_PAIRING
}

model Organization {
  id                        String               @id @default(cuid())
  name                      String
  type                      OrganizationType
  sessionMaxAgeSeconds      Int?
  sessionIdleTimeoutSeconds Int?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  memberships               Membership[]
  jobExecutions             JobExecution[]
  deadLetterJobs            DeadLetterJob[]
  humanFallbackEvents       HumanFallbackEvent[]
  llmCallLogs               LlmCallLog[]
  auditLogs                 AuditLog[]
  shippers                  Shipper[]
  requirementProfiles       RequirementProfile[]
  drivers                   Driver[]
  orders                    Order[]
  dsoBaselines              DsoBaseline[]
  historicalInvoices        HistoricalInvoice[]
  messageLogs               MessageLog[]
  channelConnections        ChannelConnection[]
  podUploadLinks            PodUploadLink[]
  podSubmissions            PodSubmission[]
  podSubmissionPages        PodSubmissionPage[]
}

model Post {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  @@index([name])
}

// Necessary for Next auth
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? // @db.Text
  access_token             String? // @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? // @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  memberships   Membership[]
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole
  createdAt      DateTime       @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Completion ledger backing job idempotency. A key that appears here has
/// already run to success, so replaying it is a no-op (TRK-005).
model JobExecution {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  idempotencyKey String
  attempts       Int      @default(1)
  completedAt    DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, name])
}

/// Jobs that exhausted their retries, with the payload and error a person
/// needs to work them by hand. Every row has a matching HumanFallbackEvent.
model DeadLetterJob {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  idempotencyKey String
  payload        Json
  error          String
  attempts       Int
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
}

/// INV-6. One row per agent failure a person now has to resolve. `instruction`
/// is plain Bahasa Indonesia describing the manual work, not an error message.
model HumanFallbackEvent {
  id             String    @id @default(cuid())
  organizationId String
  source         String
  dedupeKey      String
  entityType     String
  entityId       String?
  instruction    String
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, source, dedupeKey])
  @@index([organizationId, acknowledgedAt])
}

model LlmCallLog {
  id             String   @id @default(cuid())
  organizationId String
  loadId         String
  model          String
  promptVersion  String
  inputTokens    Int
  outputTokens   Int
  imageCount     Int
  latencyMs      Int
  estimatedCost  BigInt
  success        Boolean
  errorMessage   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, loadId])
  @@map("llm_call_logs")
}

/// Append-only record of every domain mutation. INV-1 and INV-7 are only
/// meaningful if the approval that satisfied them cannot be edited afterwards,
/// so UPDATE and DELETE are blocked by a database trigger, not by convention.
model AuditLog {
  id                 String         @id @default(cuid())
  organizationId     String
  actorType          AuditActorType
  /// Null only for SYSTEM actors, which have no identity to record.
  actorId            String?
  action             String
  entityType         String
  entityId           String
  before             Json?
  after              Json?
  ip                 String?
  userAgent          String?
  /// Set when actorType is AGENT so an agent action can be reproduced.
  /// Populated once the LLM provider lands (TRK-040, TRK-045).
  agentModel         String?
  agentPromptVersion String?
  createdAt          DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
}

model MessageLog {
  id                      String           @id @default(cuid())
  organizationId          String
  channel                 ChannelType
  direction               MessageDirection
  from                    String
  to                      String
  body                    String?          @db.Text
  status                  MessageLogStatus @default(PENDING)
  externalId              String?
  truncated               Boolean          @default(false)
  category                String           @default("WHATSAPP_BAILEYS")
  estimatedCost           Decimal          @default(0) @db.Decimal(12, 4)
  conversationWindowState String           @default("N/A")
  createdAt               DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, externalId])
  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, channel, createdAt])
}

model ChannelConnection {
  id               String                  @id @default(cuid())
  organizationId   String
  channel          ChannelType
  status           ChannelConnectionStatus @default(DISCONNECTED)
  authState        Json?
  authStateVersion Int                     @default(1)
  lastConnectedAt  DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, channel])
  @@index([organizationId])
}

/// A shipper this forwarder bills (TRK-010).
///
/// Payment terms are deliberately absent here: they live on the versioned
/// RequirementProfile. Terms on the shipper would be a single mutable value,
/// so changing them would silently re-date every packet already assembled
/// under the old terms.
model Shipper {
  id                  String   @id @default(cuid())
  organizationId      String
  name                String
  /// Tax ID. Optional because a design partner rarely has it to hand on day
  /// one, and blocking shipper creation on it stops onboarding.
  npwp                String?
  financeContactName  String?
  financeContactEmail String?
  financeContactPhone String?
  address             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requirementProfiles RequirementProfile[]
  orders              Order[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// What a shipper requires before it accepts a `berkas tagih`, versioned.
///
/// A version is immutable once written: editing means creating the next
/// version and stamping this one `supersededAt`. A database trigger rejects an
/// UPDATE to any column other than `supersededAt`, so a packet assembled under
/// version 3 can always be re-explained by reading version 3 (TRK-010, INV-7).
///
/// `rules` is JSON rather than columns because adding a new requirement type
/// must not need a migration. It is validated by the Zod schema in
/// `~/server/domain/shipper/requirement-rules` at write time.
model RequirementProfile {
  id             String    @id @default(cuid())
  organizationId String
  shipperId      String
  version        Int
  rules          Json
  /// Why this version exists, shown beside the diff against its predecessor.
  changeNote     String?
  /// Null for seeded profiles, which no user authored.
  createdById    String?
  createdAt      DateTime  @default(now())
  /// Null for the one active version. Set when a newer version replaces it,
  /// which a partial unique index enforces.
  supersededAt   DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipper      Shipper      @relation(fields: [shipperId], references: [id], onDelete: Cascade)

  @@unique([shipperId, version])
  @@index([organizationId, shipperId])
}

/// A driver, modelled as a data source rather than a user (TRK-012).
///
/// Pak Herman pays nothing and installs nothing. There is deliberately no
/// account, password, or session here: he is reached through a signed upload
/// link, so an auth surface would be a liability with no corresponding use.
model Driver {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// E.164, normalised by `~/server/domain/driver/phone` before it is stored.
  /// The unique constraint below is what makes deduplication a guarantee
  /// rather than a best effort in a resolver that two requests can race.
  phone          String
  vehiclePlate   String?
  /// The forwarder's own code for a subcontracted trucking company.
  /// Deliberately not a foreign key: no Vendor model exists and none appears
  /// in the backlog, so this is an opaque external reference, not a join.
  vendorId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@unique([organizationId, phone])
  @@index([organizationId])
}

/// One shipment, and the thing a POD is matched against (TRK-011).
///
/// `nilaiTagihan` is copied from whatever the forwarder already agreed with the
/// shipper. It is never computed, suggested, or derived here — INV-3 — and
/// `tests/invariants/inv-3-no-pricing` fails the build if arithmetic appears
/// on it anywhere in the source.
model Order {
  id                  String      @id @default(cuid())
  organizationId      String
  nomorOrder          String
  /// Carried on the surat jalan issued before the trip; the number a POD is
  /// matched against, and the natural key an import deduplicates on.
  nomorSuratJalan     String
  shipperId           String
  /// Null until a driver is assigned. An order can be planned before anyone
  /// is allocated to drive it.
  driverId            String?
  origin              String
  destination         String
  plannedDeliveryDate DateTime?
  actualDeliveryDate  DateTime?
  jumlahKoli          Int?
  /// Grams, so weight is exact integer arithmetic rather than a float that
  /// drifts once it is summed across a packet.
  weightGram          Int?
  /// Whole rupiah, copied never computed (INV-3). Not sen: the minor unit is
  /// not used in Indonesian freight invoicing, and storing it would inflate
  /// every value 100x and force a divide on the display path — the exact
  /// arithmetic the invariant test exists to forbid.
  nilaiTagihan        BigInt?
  status              OrderStatus @default(CREATED)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipper        Shipper         @relation(fields: [shipperId], references: [id], onDelete: Restrict)
  driver         Driver?         @relation(fields: [driverId], references: [id], onDelete: SetNull)
  podUploadLinks PodUploadLink[]
  podSubmissions PodSubmission[]

  @@unique([organizationId, nomorSuratJalan])
  @@index([organizationId, status])
  @@index([organizationId, shipperId])
  @@index([organizationId, driverId])
}

/// The DSO figure a customer started at, frozen before Trayek changed anything
/// (TRK-013).
///
/// Immutable by database trigger. The product is sold on removing 8 or more
/// days of DSO, and a baseline that can be edited after the fact turns month 8
/// into an argument instead of a demonstration.
model DsoBaseline {
  id                String            @id @default(cuid())
  organizationId    String
  method            DsoBaselineMethod
  /// Whole days. The claim is measured in days, so days are the unit; the
  /// inputs below are kept so the figure can be re-derived exactly.
  dsoDays           Int
  /// Inclusive range the figure describes, so two baselines are comparable.
  periodStart       DateTime
  periodEnd         DateTime
  /// Whole rupiah, for a balances-derived figure. Preserved as evidence.
  invoicedRevenue   BigInt?
  averageReceivable BigInt?
  /// How many historical invoices an invoice-derived figure was built from.
  invoiceCount      Int?
  /// The PRD's month 0-2 go/no-go signal: could the owner state a DSO figure
  /// without being prompted? Belongs in the database, not someone's notebook.
  statedUnprompted  Boolean?
  note              String?
  createdById       String?
  createdAt         DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, method])
  @@index([organizationId])
}

/// Invoices from before Trayek, imported only to compute a baseline (TRK-013).
///
/// The amount is deliberately not called `nilaiTagihan`: this is historical
/// evidence of how fast a customer got paid, not a figure Trayek bills on.
/// Nothing derives a rate, margin, or price from it (INV-3).
model HistoricalInvoice {
  id             String    @id @default(cuid())
  organizationId String
  nomorInvoice   String
  shipperName    String?
  issueDate      DateTime
  /// Null when the invoice was still unpaid at import. Unpaid invoices are
  /// excluded from the computation rather than counted as paid on day zero.
  paymentDate    DateTime?
  amountRupiah   BigInt
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, nomorInvoice])
  @@index([organizationId, issueDate])
}

/// A signed link that lets one driver upload a POD for exactly one order
/// without an account (TRK-024).
///
/// The token itself is never stored, only its SHA-256 digest, so a database
/// dump yields nothing replayable. It is an opaque random string checked
/// against this table rather than a self-describing signed blob because both
/// revocation and the use budget need server state anyway: a stateless token
/// can prove it was issued, but not that it is still allowed.
model PodUploadLink {
  id             String    @id @default(cuid())
  organizationId String
  orderId        String
  /// SHA-256 of the token, hex. Unique, so resolving a link is one indexed
  /// read and two links can never collide on the same secret.
  tokenHash      String    @unique
  expiresAt      DateTime
  /// A driver retakes photos, so one link is worth several uploads. Not
  /// unlimited: an exhausted budget is what keeps a leaked link from being a
  /// standing write endpoint.
  useBudget      Int
  useCount       Int       @default(0)
  lastUsedAt     DateTime?
  /// Set by revocation and by rotation, which revokes the link it replaces.
  /// Nulling this again is never correct — issue a new link instead.
  revokedAt      DateTime?
  /// Null when a link was issued by a job rather than by a person.
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  submissions  PodSubmission[]

  @@index([organizationId, orderId])
  @@index([organizationId, expiresAt])
}

/// Fixed-window request counters for the public POD upload route (TRK-024).
///
/// Deliberately not tenant-scoped: an IP bucket belongs to no organization,
/// and the route is reached before any tenant is known. Only digests are
/// stored. A raw IP is personal data under UU PDP, and a raw token here would
/// undo the point of hashing it on `PodUploadLink`.
model PodUploadThrottle {
  bucket          String   @id
  windowStartedAt DateTime
  count           Int
  updatedAt       DateTime @updatedAt

  @@index([windowStartedAt])
}

/// One POD as the driver submitted it (TRK-030).
///
/// A submission is the logical document, not the photograph: a `surat jalan`
/// with a continuation sheet is one POD in two captures, and extraction
/// (TRK-041) reads it as one. The photographs hang off `pages`.
///
/// Nothing here is ever overwritten. A driver who re-uploads because he was
/// unsure creates a second submission, and that duplication is a fraud signal
/// (TRK-060), not a row to reconcile away.
model PodSubmission {
  id              String   @id @default(cuid())
  organizationId  String
  orderId         String
  /// The link the driver came through. Kept so a submission can be traced
  /// back to who issued the link and when, which is the only identity a
  /// driver has (TRK-024).
  podUploadLinkId String
  /// When the server accepted it. The client's own clock is captured
  /// separately by TRK-032, because the two disagreeing is itself a signal.
  receivedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  /// The worst page score in this submission, 0-100 (TRK-031). A rollup, not
  /// a separate measurement: a three-page POD is only as readable as its
  /// least readable page, and that is the page extraction will fail on.
  /// Null when the client sent no quality data at all.
  lowestQualityScore Int?
  /// True when the driver was warned about any page and sent it anyway.
  /// Not a fault: a blurry POD beats no POD, and the flag is what lets the
  /// correlation in TRK-044 separate warned uploads from clean ones.
  qualityOverridden  Boolean @default(false)

  /// Where the browser said the driver was, at capture time (TRK-032).
  ///
  /// Captured independently of EXIF, which WhatsApp strips from forwarded
  /// images and which a browser upload can lose anyway. Feeds the geospatial
  /// plausibility check in TRK-062.
  ///
  /// Personal data under UU PDP: collected against a consent prompt shown
  /// before the browser is asked, retained under the policy in TRK-140, and
  /// never written to a log line.
  captureLatitude       Float?
  captureLongitude      Float?
  /// Radius of the reported position in metres, as the browser gave it. A
  /// 2000 m accuracy is a cell-tower fix, not a GPS one, and TRK-062 has to
  /// be able to tell the difference before calling anything implausible.
  captureAccuracyMeters Float?
  /// The client's own clock at capture. Kept beside `receivedAt` rather than
  /// replacing it: the two disagreeing is itself a signal, and a phone clock
  /// is trivially wrong or deliberately set.
  capturedAt            DateTime?
  /// Null only for submissions predating TRK-032.
  geolocationPermission GeolocationPermission?

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order         Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  podUploadLink PodUploadLink       @relation(fields: [podUploadLinkId], references: [id], onDelete: Restrict)
  pages         PodSubmissionPage[]

  @@index([organizationId, orderId])
  @@index([organizationId, receivedAt])
}

/// One photograph of a POD, in the order the driver captured it (TRK-030).
///
/// `storageKey` is the original bytes, untouched. Preprocessing (TRK-042)
/// writes its derivative to its own key and never here: fraud forensics
/// (TRK-061) reads EXIF off the original, and a rotated, recompressed copy
/// has none left to read.
model PodSubmissionPage {
  id                String   @id @default(cuid())
  organizationId    String
  podSubmissionId   String
  /// Zero-based, the order the driver took them in.
  pageIndex         Int
  /// Opaque storage key. Never logged, never put in a URL that outlives its
  /// purpose: a POD carries a signature, which is personal data under UU PDP.
  storageKey        String
  fileName          String
  contentType       String
  sizeBytes         Int
  /// Capture quality for this photograph, 0-100 (TRK-031).
  ///
  /// Measured in the browser before upload and therefore advisory: it is
  /// client-supplied and forgeable, so it may inform a human and feed the
  /// TRK-044 correlation, and must never gate a write or authorize anything.
  /// Null when the browser could not decode the image to measure it.
  qualityScore      Int?
  /// The individual checks and their measured values, kept so a threshold
  /// can be retuned later against photographs already collected rather than
  /// only against ones taken after the change.
  qualityChecks     Json?
  /// True when this page was warned about and sent anyway.
  qualityOverridden Boolean  @default(false)
  createdAt         DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  podSubmission PodSubmission @relation(fields: [podSubmissionId], references: [id], onDelete: Cascade)

  @@unique([podSubmissionId, pageIndex])
  @@index([organizationId, podSubmissionId])
}
